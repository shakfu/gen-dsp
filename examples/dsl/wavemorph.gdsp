# Waveform morph using cosine interpolation.
# An LFO crossfades between a saw and a sine oscillator at the same pitch
# with a smooth (cosine) blend instead of a linear one.
# Exercises the new `interp` node in cosine mode.

graph wavemorph {
    out out1 = result

    param freq 20..2000 = 220
    param rate 0.01..5  = 0.3
    param amp  0..1     = 0.4

    a = sawosc(freq)
    b = sinosc(freq)

    # LFO in [0, 1] sets the morph position.
    lfo = sinosc(rate)
    t   = lfo * 0.5 + 0.5

    morph  = interp(a, b, t, mode=cosine)
    result = morph * amp
}
