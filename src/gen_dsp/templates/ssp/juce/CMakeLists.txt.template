cmake_minimum_required(VERSION 3.22)

# Percussa SSP module for $lib_name, JUCE format
# Generated by gen-dsp v$gendsp_version
#
# Builds against the SSP plugin framework (plugins/common of
# https://github.com/shakfu/ssp) and TheTechnobear's JUCE fork. SSP_DEV_DIR
# points at an existing checkout of that repository, with its juce/ and
# ssp-sdk/ submodules; unset, pinned archives of all three are downloaded once.
# The framework is AGPL-3.0, so a built module is too.

option(SSP_HOST_BUILD "Build for the host instead of the SSP" OFF)

set(SSP_DEV_DIR "$dev_dir" CACHE PATH "SSP dev tree (a shakfu/ssp checkout); empty downloads one")
if(NOT SSP_DEV_DIR AND DEFINED ENV{SSP_DEV_DIR})
    set(SSP_DEV_DIR "$$ENV{SSP_DEV_DIR}" CACHE PATH "" FORCE)
endif()

# Shared FetchContent cache (optional -- gen-dsp --shared-cache). Set before
# project() so the toolchain can cache the SSP buildroot there too.
if(DEFINED ENV{GEN_DSP_CACHE_DIR})
    file(TO_CMAKE_PATH "$$ENV{GEN_DSP_CACHE_DIR}" _gen_dsp_cache)
    set(FETCHCONTENT_BASE_DIR "$${_gen_dsp_cache}" CACHE PATH "" FORCE)
elseif($use_shared_cache)
    set(_gen_dsp_cache_override "$cache_dir")
    if(_gen_dsp_cache_override)
        set(_gen_dsp_cache "$${_gen_dsp_cache_override}")
    elseif(CMAKE_HOST_APPLE)
        set(_gen_dsp_cache "$$ENV{HOME}/Library/Caches/gen-dsp/fetchcontent")
    elseif(DEFINED ENV{XDG_CACHE_HOME})
        set(_gen_dsp_cache "$$ENV{XDG_CACHE_HOME}/gen-dsp/fetchcontent")
    else()
        set(_gen_dsp_cache "$$ENV{HOME}/.cache/gen-dsp/fetchcontent")
    endif()
    file(TO_CMAKE_PATH "$${_gen_dsp_cache}" _gen_dsp_cache)
    set(FETCHCONTENT_BASE_DIR "$${_gen_dsp_cache}" CACHE PATH "" FORCE)
endif()

# a dev tree's buildroot, unless one is set explicitly
set(_ssp_dev_buildroot "$${SSP_DEV_DIR}/buildroot/arm-rockchip-linux-gnueabihf_sdk-buildroot")
if(SSP_DEV_DIR AND NOT SSP_BUILDROOT AND NOT DEFINED ENV{SSP_BUILDROOT}
   AND EXISTS "$${_ssp_dev_buildroot}/arm-rockchip-linux-gnueabihf/sysroot")
    set(SSP_BUILDROOT "$${_ssp_dev_buildroot}" CACHE PATH "Percussa SSP buildroot")
endif()

if(NOT SSP_HOST_BUILD AND NOT CMAKE_TOOLCHAIN_FILE)
    set(CMAKE_TOOLCHAIN_FILE "$${CMAKE_CURRENT_SOURCE_DIR}/ssp_toolchain.cmake")
endif()
if(NOT CMAKE_BUILD_TYPE)
    set(CMAKE_BUILD_TYPE Release CACHE STRING "" FORCE)
endif()

set(PROJECT_NAME $lib_name)
project($${PROJECT_NAME} VERSION $project_version LANGUAGES C CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

# Synthor lists a module only if its uid spells its 4-character name. Pick one
# no other module on the card uses.
set(SSP_MODULE_NAME "$module_name" CACHE STRING "SSP module name, exactly 4 letters or digits")
if(NOT SSP_MODULE_NAME MATCHES "^[A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9]$$")
    message(FATAL_ERROR "SSP_MODULE_NAME '$${SSP_MODULE_NAME}' must be exactly 4 letters or digits")
endif()
string(TOUPPER "$${SSP_MODULE_NAME}" _ssp_code)

if(POLICY CMP0135)
    cmake_policy(SET CMP0135 NEW)
endif()

if(SSP_DEV_DIR)
    foreach(_f plugins/common/SSPApi.h juce/CMakeLists.txt ssp-sdk/Percussa.h)
        if(NOT EXISTS "$${SSP_DEV_DIR}/$${_f}")
            message(FATAL_ERROR "SSP_DEV_DIR $${SSP_DEV_DIR} has no $${_f}; init its submodules")
        endif()
    endforeach()
    set(_ssp_tree "$${SSP_DEV_DIR}")
    set(_ssp_juce "$${SSP_DEV_DIR}/juce")
else()
    # Archives, not clones. SOURCE_SUBDIR names no CMakeLists, so FetchContent only
    # downloads; JUCE is added below with a build dir in this project, not the
    # shared cache, so host and cross builds do not share one.
    include(FetchContent)
    FetchContent_Declare(
        ssp_dev
        URL https://github.com/shakfu/ssp/archive/$framework_commit.tar.gz
        URL_HASH SHA256=$framework_sha256
        SOURCE_SUBDIR _none
    )
    FetchContent_MakeAvailable(ssp_dev)
    set(_ssp_tree "$${ssp_dev_SOURCE_DIR}")
    # the framework includes ../../ssp-sdk/Percussa.h, so the SDK goes inside the tree
    FetchContent_Declare(
        ssp_dev_sdk
        URL https://github.com/percussa/ssp-sdk/archive/670b537083937a29c154358df1bc8264013366c4.tar.gz
        URL_HASH SHA256=1f0dd25b7eea95cc5b260ceada402012e41bf8ed99109017bf0daca988081e3e
        SOURCE_DIR "$${_ssp_tree}/ssp-sdk"
        SOURCE_SUBDIR _none
    )
    FetchContent_Declare(
        ssp_juce
        URL https://github.com/TheTechnobear/juce/archive/$juce_commit.tar.gz
        URL_HASH SHA256=$juce_sha256
        SOURCE_SUBDIR _none
    )
    FetchContent_MakeAvailable(ssp_dev_sdk ssp_juce)
    set(_ssp_juce "$${ssp_juce_SOURCE_DIR}")
endif()
add_subdirectory("$${_ssp_juce}" "$${CMAKE_BINARY_DIR}/juce")

set(_ssp_common "$${_ssp_tree}/plugins/common")

juce_add_plugin($${PROJECT_NAME}
    COMPANY_NAME "gen-dsp"
    DESCRIPTION "$lib_name"
    COPY_PLUGIN_AFTER_BUILD FALSE
    PLUGIN_MANUFACTURER_CODE Gdsp
    PLUGIN_CODE $${_ssp_code}
    FORMATS VST3
    VST3_AUTO_MANIFEST FALSE
    PRODUCT_NAME "$${SSP_MODULE_NAME}")

# The framework's own source lists, written relative to a plugin folder beside common/
include("$${_ssp_common}/CMakeLists.txt")
include("$${_ssp_common}/engine/CMakeLists.txt")
list(TRANSFORM COMMON_SRC REPLACE "^\\.\\./common/" "$${_ssp_common}/")
list(TRANSFORM ENGINE_SRC REPLACE "^\\.\\./common/" "$${_ssp_common}/")

# SSPApi.cpp is PUBLIC so the entry points link into the module itself
target_sources($${PROJECT_NAME}
    PUBLIC
    "$${CMAKE_CURRENT_SOURCE_DIR}/SSPApi.cpp"
    PRIVATE
$sources
    $${COMMON_SRC}
    $${ENGINE_SRC}
)

target_include_directories($${PROJECT_NAME} PRIVATE
    "$${CMAKE_CURRENT_SOURCE_DIR}"
$include_dirs
    "$${_ssp_common}"
)

target_compile_definitions($${PROJECT_NAME} PUBLIC
    JUCE_WEB_BROWSER=0
    JUCE_USE_CURL=0
    JUCE_VST3_CAN_REPLACE_VST2=0
    JUCE_DISABLE_JUCE_VERSION_PRINTING=1
    TARGET_SSP=1
    COMPACT_UI_SCALE=2
    SSP_TITLE_NO_MANUFACTURER=1
    SSP_VERSION_FROM_PROJECT=1
    SSP_MODULE_NAME="$${SSP_MODULE_NAME}"
    GENLIB_USE_FLOAT32
    SSP_EXT_NAME=$lib_name
    GEN_EXPORTED_NAME=$gen_name
    GEN_EXPORTED_HEADER="$gen_name.h"
    GEN_EXPORTED_CPP="$gen_name.cpp"
    $remap_defines
)

target_compile_options($${PROJECT_NAME} PRIVATE -Wno-unused-function -Wno-unused-variable)

target_link_libraries($${PROJECT_NAME} PRIVATE juce::juce_audio_utils)

# Synthor loads every module into one process: keep genlib and the framework private
set_target_properties($${PROJECT_NAME} $${PROJECT_NAME}_VST3 PROPERTIES
    C_VISIBILITY_PRESET hidden
    CXX_VISIBILITY_PRESET hidden
    VISIBILITY_INLINES_HIDDEN ON
)
set_target_properties($${PROJECT_NAME}_VST3 PROPERTIES PREFIX "")
# Visibility misses genlib's replacement operator new/delete and inline std::
# instances: the version script hides them. Apple's linker has no version scripts.
if(NOT APPLE)
    set(_ssp_map "$${CMAKE_CURRENT_SOURCE_DIR}/ssp_exports.map")
    target_link_options($${PROJECT_NAME}_VST3 PRIVATE "-Wl,--version-script=$${_ssp_map}")
    set_property(TARGET $${PROJECT_NAME}_VST3 APPEND PROPERTY LINK_DEPENDS "$${_ssp_map}")
endif()

# the .so inside the VST3 bundle is the module; copy it out under its card name
add_custom_command(TARGET $${PROJECT_NAME}_VST3 POST_BUILD
    COMMAND "$${CMAKE_COMMAND}" -E copy "$$<TARGET_FILE:$${PROJECT_NAME}_VST3>"
            "$${CMAKE_BINARY_DIR}/$${SSP_MODULE_NAME}.so"
    VERBATIM)
