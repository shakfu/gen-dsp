[package]
name = "$crate_name"
version = "0.1.0"
edition = "2024"
description = "gen~ $gen_name as a CLAP/VST3 plugin, generated by gen-dsp v$gendsp_version"
publish = false

[lib]
# cdylib is the plugin; lib lets other crates and `cargo test` use it.
crate-type = ["cdylib", "lib"]

[features]
# Generic egui editor with one slider per parameter.
gui = ["dep:nice-plug-egui", "dep:egui"]

[dependencies]
nice-plug = "0.4.2"
nice-plug-egui = { version = "0.5.1", optional = true }
egui = { version = "0.36.1", optional = true, features = ["default_fonts"] }

[build-dependencies]
cc = "1"

[workspace]
members = ["xtask"]
