//! $plugin_name: nice-plug plugin around the gen~ code `$gen_name`.
//!
//! Generated by gen-dsp v$gendsp_version. The DSP runs in C++ behind
//! `engine::Engine`; this file maps it onto nice-plug's `Plugin` trait.
//! Regenerating the project overwrites it.

use nice_plug::prelude::*;
use std::sync::Arc;

#[cfg(feature = "gui")]
mod editor;
pub mod engine;

use engine::Engine;

/// Signal inputs and outputs of the gen~ code.
pub const NUM_INPUTS: usize = $num_inputs;
pub const NUM_OUTPUTS: usize = $num_outputs;
pub const NUM_PARAMS: usize = $num_params;

/// nice-plug's main buffer carries only as many channels as the main output,
/// so inputs beyond that arrive on one auxiliary input port.
const MAIN_INPUTS: usize = $main_inputs;

#[derive(Params)]
pub struct GenParams {
$param_fields}

impl Default for GenParams {
    fn default() -> Self {
        Self {
$param_inits        }
    }
}

impl GenParams {
    /// Plain values in gen~ parameter order.
    pub fn values(&self) -> [f32; NUM_PARAMS] {
        [$param_values]
    }
}

#[cfg(feature = "gui")]
fn param_widgets(ui: &mut egui::Ui, params: &GenParams, setter: &ParamSetter) {
$param_widgets}

pub struct $struct_name {
    params: Arc<GenParams>,
    engine: Option<Engine>,
    /// Values last passed to the engine; NaN forces a resend.
    sent: [f32; NUM_PARAMS],
    /// Input copies, so gen~ never reads a channel it has already overwritten.
    scratch: Vec<Vec<f32>>,
}

impl Default for $struct_name {
    fn default() -> Self {
        Self {
            params: Arc::new(GenParams::default()),
            engine: None,
            sent: [f32::NAN; NUM_PARAMS],
            scratch: Vec::new(),
        }
    }
}

impl Plugin for $struct_name {
    const NAME: &'static str = "$plugin_name";
    const VENDOR: &'static str = "gen-dsp";
    const URL: &'static str = "";
    const EMAIL: &'static str = "";
    const VERSION: &'static str = env!("CARGO_PKG_VERSION");

    const AUDIO_IO_LAYOUTS: &'static [AudioIOLayout] = &[AudioIOLayout {
        main_input_channels: NonZeroU32::new(MAIN_INPUTS as u32),
        main_output_channels: NonZeroU32::new(NUM_OUTPUTS as u32),
        aux_input_ports: &[$aux_input_ports],
        aux_output_ports: &[],
        names: PortNames::const_default(),
    }];

    const MIDI_INPUT: MidiConfig = MidiConfig::$midi_config;
    // The wrapper splits blocks at automation points, so reading parameters
    // once per block is sample accurate.
    const SAMPLE_ACCURATE_AUTOMATION: bool = true;

    #[cfg(feature = "gui")]
    type Editor = nice_plug_egui::EguiEditor<editor::GenEditor>;
    #[cfg(not(feature = "gui"))]
    type Editor = ();
    type SysExMessage = ();
    type BackgroundTask = ();

    fn params(&self) -> Arc<dyn Params> {
        self.params.clone()
    }

    #[cfg(feature = "gui")]
    fn editor(&mut self, _async_executor: AsyncExecutor<Self>) -> Option<Self::Editor> {
        editor::create(self.params.clone())
    }

    fn activate(
        &mut self,
        _audio_io_layout: &AudioIOLayout,
        buffer_config: &BufferConfig,
        _context: &mut impl ActivateContext<Self>,
    ) -> bool {
        let max_frames = buffer_config.max_buffer_size as usize;
        self.engine = Engine::new(buffer_config.sample_rate, max_frames);
        self.scratch = vec![vec![0.0; max_frames]; NUM_INPUTS];
        self.sent = [f32::NAN; NUM_PARAMS];
        self.engine.is_some()
    }

    fn reset(&mut self) {
        if let Some(engine) = &mut self.engine {
            engine.reset();
        }
    }

    fn process(
        &mut self,
        buffer: &mut Buffer,
        aux: &mut AuxiliaryBuffers,
        context: &mut impl ProcessContext<Self>,
    ) -> ProcessStatus {
        let Some(engine) = &mut self.engine else {
            return ProcessStatus::Error("gen~ engine not activated");
        };
        for (i, value) in self.params.values().into_iter().enumerate() {
            if value != self.sent[i] {
                engine.set_param(i, value);
                self.sent[i] = value;
            }
        }

        // Render up to each note event, then apply it.
        let len = buffer.samples();
        let mut start = 0;
        while let Some(event) = context.next_event() {
            let at = (event.timing() as usize).min(len);
            if at > start {
                render(engine, &mut self.scratch, buffer, aux, start, at);
                start = at;
            }
            match event {
                NoteEvent::NoteOn { key, velocity, .. } => {
                    if let Some(key) = key.number() {
                        engine.note_on(key, velocity);
                    }
                }
                // A wildcard key releases every note.
                NoteEvent::NoteOff { key, .. } => match key.number() {
                    Some(key) => engine.note_off(key),
                    None => (0..128).for_each(|key| engine.note_off(key)),
                },
                _ => {}
            }
        }
        if start < len {
            render(engine, &mut self.scratch, buffer, aux, start, len);
        }

        // gen~ code can ring indefinitely (reverbs, feedback delays).
        ProcessStatus::KeepAlive
    }
}

/// Run the engine over samples `start..end` of the block.
fn render(
    engine: &mut Engine,
    scratch: &mut [Vec<f32>],
    buffer: &mut Buffer,
    aux: &mut AuxiliaryBuffers,
    start: usize,
    end: usize,
) {
    let n = end - start;
    for (ch, dst) in scratch.iter_mut().enumerate() {
        let src = if ch < MAIN_INPUTS {
            &buffer.as_slice_immutable()[ch][start..end]
        } else {
            &aux.inputs[0].as_slice_immutable()[ch - MAIN_INPUTS][start..end]
        };
        dst[..n].copy_from_slice(src);
    }
    let inputs: [&[f32]; NUM_INPUTS] = std::array::from_fn(|ch| &scratch[ch][..n]);
    let mut channels = buffer.as_slice().iter_mut();
    let mut outputs: [&mut [f32]; NUM_OUTPUTS] =
        std::array::from_fn(|_| &mut channels.next().unwrap()[start..end]);
    engine.process(&inputs, &mut outputs);
}

impl ClapPlugin for $struct_name {
    const CLAP_ID: &'static str = "$clap_id";
    const CLAP_DESCRIPTION: Option<&'static str> = Some("gen~ $gen_name (gen-dsp)");
    const CLAP_MANUAL_URL: Option<&'static str> = None;
    const CLAP_SUPPORT_URL: Option<&'static str> = None;
    const CLAP_FEATURES: &'static [ClapFeature] = &[$clap_features];
}

impl Vst3Plugin for $struct_name {
    const VST3_CLASS_ID: [u8; 16] = *b"$vst3_class_id";
    const VST3_SUBCATEGORIES: &'static [Vst3SubCategory] = &[$vst3_subcategories];
}

nice_export_clap!($struct_name);
nice_export_vst3!($struct_name);

#[cfg(test)]
mod tests {
    use super::*;

    /// The Rust constants must match what the C++ side was compiled with.
    #[test]
    fn io_matches_gen_code() {
        assert_eq!(engine::num_inputs(), NUM_INPUTS);
        assert_eq!(engine::num_outputs(), NUM_OUTPUTS);
        assert_eq!(engine::num_params(), NUM_PARAMS);
    }

    #[test]
    fn defaults_reach_the_engine() {
        let params = GenParams::default();
        let mut engine = Engine::new(48000.0, 64).expect("engine");
        for (i, value) in params.values().into_iter().enumerate() {
            engine.set_param(i, value);
            assert_eq!(engine.param(i), value, "param {i}");
        }
    }

    #[test]
    fn renders_finite_audio() {
        let mut engine = Engine::new(48000.0, 64).expect("engine");
        for (i, value) in GenParams::default().values().into_iter().enumerate() {
            engine.set_param(i, value);
        }
        engine.note_on(60, 1.0);
        let input: Vec<f32> = (0..64).map(|i| if i == 0 { 1.0 } else { 0.0 }).collect();
        let inputs: [&[f32]; NUM_INPUTS] = std::array::from_fn(|_| &input[..]);
        let mut out = vec![vec![0.0f32; 64]; NUM_OUTPUTS];
        let mut outputs: Vec<&mut [f32]> = out.iter_mut().map(|c| &mut c[..]).collect();
        for _ in 0..16 {
            engine.process(&inputs, &mut outputs);
            assert!(outputs.iter().all(|c| c.iter().all(|s| s.is_finite())));
        }
    }
}
